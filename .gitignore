# =============================================================================
# Godot AI Companion — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Godot editor / generated (never commit)
# -----------------------------------------------------------------------------
.godot/
.import/
export.cfg
export_presets.cfg
*.translation

# Imported assets (regenerated by the editor)
*.import

# Mono / C# (if ever added)
.mono/
data_*/
mono_crash.*.json

# Android / iOS build leftovers
android/
ios/
*.apk
*.aab
*.ipa

# -----------------------------------------------------------------------------
# OS / IDE
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/
.claude/
*.code-workspace

# -----------------------------------------------------------------------------
# Secrets — the plugin stores API keys in Godot EditorSettings (outside the
# project). Still ignore anything that might accidentally land in the tree.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
# Private key material (do not ignore Godot *.gd.uid — those are script UIDs)
*.key
!*.gd.uid
# Credential dumps — keep plugin source like core/secrets.gd
secrets.json
secrets.txt
secrets.env
**/secrets/
credentials.json
credentials.txt
credentials.env
**/credentials/
openrouter*.txt
.ollama/

# -----------------------------------------------------------------------------
# Local / AI-tooling / agent scratch (not part of the plugin)
# -----------------------------------------------------------------------------
.mcp.json
.forge/
.aider*
.continue/
plans/
*.log
*.tmp
*.bak
*.orig

# Ad-hoc local test scripts (not the committed test_fixtures/)
/test_*.gd
/test_*.tscn
/tmp/
/temp/

# Coverage / profiling
*.gcda
*.gcno
coverage/
